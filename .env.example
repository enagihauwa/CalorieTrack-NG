# Copy to .env.local for local development. Never commit the real .env.local.

# Postgres connection string used by Prisma (TICKET-003).
# Local dev example: postgresql://postgres:postgres@localhost:5432/calorietrack_ng
DATABASE_URL="postgresql://user:password@localhost:5432/calorietrack_ng"

# NextAuth (TICKET-006/007). Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-random-secret"
NEXTAUTH_URL="http://localhost:3000"
